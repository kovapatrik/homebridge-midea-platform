{
  "name": "@jouskaio/homebridge-midea-portasplit",
  "version": "1.3.4",
  "description": "Homebridge plugin for Midea devices",
  "keywords": [
    "ac",
    "air-conditioner",
    "homebridge-plugin",
    "midea",
    "portasplit"
  ],
  "bugs": {
    "url": "https://github.com/Jouskaio/homebridge-midea-platform/issues"
  },
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Jouskaio/homebridge-midea-platform.git"
  },
  "funding": [],
  "type": "module",
  "main": "dist/index.js",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "watch": "npm run build && npm link && nodemon",
    "build": "rimraf ./dist && tsc && npm run build:ui",
    "build:ui": "rolldown -c rolldown.config.ts",
    "prepublishOnly": "npm run lint && npm run fmt:check && npm run build",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check"
  },
  "dependencies": {
    "@homebridge/plugin-ui-utils": "^2.2.4",
    "axios": "^1.18.1",
    "fakegato-history": "^0.6.6",
    "fast-xml-parser": "^5.9.3",
    "lodash-es": "^4.18.1",
    "luxon": "^3.7.2",
    "semaphore-promise": "^1.4.4"
  },
  "devDependencies": {
    "@types/alpinejs": "^3.13.11",
    "@types/lodash-es": "^4.17.12",
    "@types/luxon": "^3.7.2",
    "@types/node": "^25.9.4",
    "alpinejs": "^3.15.12",
    "homebridge": "^2.1.0",
    "nodemon": "^3.1.14",
    "oxfmt": "^0.57.0",
    "oxlint": "^1.72.0",
    "rimraf": "^6.1.3",
    "rolldown": "^1.1.2",
    "ts-node": "^10.9.2",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3"
  },
  "engines": {
    "homebridge": "^1.8.0 || ^2.0.0",
    "node": "^22.10.0 || ^24.0.0"
  }
}
